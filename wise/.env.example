# Wise Banki Mikorszerviz — konfiguráció

# Wise API hitelesítés
WISE_API_KEY=your-wise-api-key-here
WISE_PROFILE_ID=12345678
WISE_ACCOUNT_CURRENCY=EUR
# Sandbox mód (true = teszt környezet, false = éles)
WISE_SANDBOX=false

# FastAPI szerver beállítások
API_HOST=0.0.0.0
API_PORT=8004

# Logging szint: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# HTTP kliens beállítások
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=1.0
