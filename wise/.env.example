# Wise Banki Mikorszerviz — konfiguráció

# Wise API hitelesítés
WISE_API_KEY=your-wise-api-key-here
WISE_PROFILE_ID=12345678
WISE_ACCOUNT_CURRENCY=EUR
# Sandbox mód (true = teszt környezet, false = éles)
WISE_SANDBOX=false

# FastAPI szerver beállítások
API_HOST=0.0.0.0
API_PORT=8004

# Logging szint: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# SCA (Strong Customer Authentication) — szükséges a bankszámlakivonat letöltéséhez
# 1. Hozz létre RSA kulcspárt: openssl genrsa -out wise_sca_private.pem 2048
# 2. Exportáld a nyilvános kulcsot: openssl rsa -in wise_sca_private.pem -pubout -out wise_sca_public.pem
# 3. Regisztráld a nyilvános kulcsot: Wise → Settings → API tokens → Manage → SCA key
WISE_SCA_PRIVATE_KEY_PATH=./wise_sca_private.pem

# CSV import — a Wise webfelületről kézzel letöltött kivonat CSV-k mappája
# Fájlnév-séma: statement_<balanceId>_<currency>_<from>_<to>.csv
# Default: <projekt>/balance-statements
# BALANCE_STATEMENTS_DIR=./balance-statements

# HTTP kliens beállítások
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=1.0
