# invoice-file-filter — configuration

# Base URL of the attachment-downloader service
ATTACHMENT_DOWNLOADER_URL=http://localhost:8000

# Default directory where PDFs are downloaded / read from
OUTPUT_DIR=../attachment-downloader/downloads

# Max seconds to wait for attachment-downloader (synchronous)
DOWNLOAD_TIMEOUT=120

# TTL for in-process PDF text/words/page-count caches (seconds)
CACHE_TTL_SECONDS=3600

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8001

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Invoice detection keywords (JSON array, case-insensitive, diacritics-folded)
INVOICE_KEYWORDS=["invoice","bill","szamla","számla","számviteli bizonylat"]
