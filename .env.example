# Consolidated environment file for `docker-compose up`.
# Copy to .env and fill in before running. This single file is read by every
# service container (docker-compose.yml sets `env_file: ./.env` for all of
# them) — it is NOT used for local `uv run` dev, which still reads each
# service's own <service>/.env (see CLAUDE.md).

# Hostname/domain the BROWSER uses to reach these services (not the Docker
# internal service names). Used to build browser-facing redirect URLs for
# auth/vision and the oauth2-proxy callback for Dozzle. Defaults to localhost.
PUBLIC_HOST=localhost

# --- PostgreSQL (db + invoice-core) ---
DB_NAME=invoice
DB_USER=graphtrek
DB_PWD=graphtrek
DB_PORT=5432

# --- Dozzle (container log viewer) — Google login via oauth2-proxy ---
# You can reuse the same Google OAuth 2.0 Client as GOOGLE_CLIENT_ID/SECRET
# below. Dozzle usually lives on its own subdomain in production (separate
# from PUBLIC_HOST), so its redirect URL is configured independently — set
# DOZZLE_REDIRECT_URL to the exact public https URL (no port, since nginx
# terminates TLS on 443 and proxies to 8008 internally), e.g.:
#   DOZZLE_REDIRECT_URL=https://tirologs.example.com/oauth2/callback
# and add that same URI as an Authorized redirect URI on the Google OAuth
# client. Defaults to http://localhost:8008/oauth2/callback for local dev.
DOZZLE_REDIRECT_URL=http://localhost:8008/oauth2/callback
DOZZLE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
DOZZLE_GOOGLE_CLIENT_SECRET=<titkos>
# Restrict login to this email domain (comma-separated for multiple).
DOZZLE_EMAIL_DOMAIN=graphtrek.co
# Random 32-byte secret for oauth2-proxy's session cookie, e.g.:
#   openssl rand -base64 32
DOZZLE_COOKIE_SECRET=

# --- pgAdmin — Google login (native OAuth2 support, no proxy needed) ---
# You can reuse the same Google OAuth 2.0 Client — just add
# http://<PUBLIC_HOST>:5050/oauth2/authorize as an extra Authorized redirect
# URI on that client in Google Cloud Console.
PGADMIN_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
PGADMIN_GOOGLE_CLIENT_SECRET=<titkos>
# Restrict login to this Google Workspace domain (Google's 'hd' claim).
# Leave blank to allow any Google account.
PGADMIN_GOOGLE_HD=graphtrek.co

# =============================================================================
# auth — central authentication (port 8007)
# =============================================================================
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<titkos>
OAUTH_REDIRECT_URL=http://localhost:8007/auth/google/callback

# JWT (keypair generated once via `uv run auth keygen`, mounted through the
# auth-keys volume — paths below are inside the container)
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
JWT_AUDIENCE=moneypenny
JWT_ISSUER=auth-service

# Whitelist — only these emails/domains may log in
ALLOWED_EMAILS=
ALLOWED_DOMAINS=graphtrek.co

ENABLED_PROVIDERS=google

# Cookies (true behind HTTPS)
COOKIE_SECURE=false

# =============================================================================
# attachment-downloader — Gmail PDF downloader (port 8000)
# =============================================================================
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
CACHE_TTL_SECONDS=60
DOWNLOAD_ROOT_DIR=downloads
# Every other service defaults to AUTH_ENABLED=true below; attachment-downloader
# is the one exception, overridden back to false in docker-compose.yml.

# =============================================================================
# nav-invoice — NAV Online Számla 3.0 client (port 8002)
# =============================================================================
USERNAME=your_technical_user_login
PASSWORD=your_password
LICENSE_KEY=your_xml_sign_key
CSERE_KEY=your_xml_exchange_key
TAX_NUMBER=12345678

SOFTWARE_ID=HU12345678SOFTWARE
SOFTWARE_NAME=nav-szamla-python
SOFTWARE_OPERATION=LOCAL_SOFTWARE
SOFTWARE_MAIN_VERSION=0.1.0
SOFTWARE_DEV_NAME=Your Company
SOFTWARE_DEV_CONTACT=dev@example.com
SOFTWARE_DEV_COUNTRY_CODE=HU
SOFTWARE_DEV_TAX_NUMBER=12345678

# "test" or "production"
ENVIRONMENT=production
# Full base URL override (/invoiceService/v3). Leave blank to derive from ENVIRONMENT.
ENDPOINT_URL=https://api.onlineszamla.nav.gov.hu/invoiceService/v3

# =============================================================================
# bank / uploader — consolidated bank statement service (ports 8005 / 8006)
# =============================================================================
ERSTE_SUBDIR=erste
WISE_SUBDIR=wise
MAX_FILE_SIZE_MB=50

# =============================================================================
# invoice-file-filter — PDF extraction + invoice filtering (port 8001)
# =============================================================================
DOWNLOAD_TIMEOUT=120
INVOICE_KEYWORDS=["invoice","bill","szamla","számla","számviteli bizonylat"]

# =============================================================================
# invoice-core — master orchestrator (port 8004)
# =============================================================================
SYNC_TIMEOUT=300
TAX_ACCOUNTS={"10032000-01076868-00000000":"NAV ÁFA","10032000-01076301-00000000":"NAV Bírság","10032000-06055950-00000000":"NAV SZJA","10032000-06055912-00000000":"NAV Szochó","10032000-01076019-00000000":"NAV TAO","10032000-06055819-00000000":"NAV TB","12001008-00272513-00100005":"HIPA","12001008-00335345-00100002":"HIPA - Késedelmi","12100011-10639683-00000000":"Iparkamara"}

# =============================================================================
# vision — frontend (port 8009)
# =============================================================================
SRCPROFIT_URL=https://srcprofit2.graphtrek.co
SRCPROFIT_USER=admin
SRCPROFIT_PASSWORD=
REQUEST_TIMEOUT=10

# =============================================================================
# Shared across all services
# =============================================================================
API_HOST=0.0.0.0
LOG_LEVEL=INFO
# JWT-protection toggle — true everywhere except attachment-downloader
# (overridden to false in docker-compose.yml).
AUTH_ENABLED=true
