# NAV Online Számla 3.0 technical user (technikai felhasználó) credentials
USERNAME=your_technical_user_login
PASSWORD=your_password
LICENSE_KEY=your_xml_sign_key
CSERE_KEY=your_xml_exchange_key
TAX_NUMBER=12345678

# Software registration (required in every request, see NAV XSD)
SOFTWARE_ID=HU12345678SOFTWARE
SOFTWARE_NAME=nav-szamla-python
SOFTWARE_OPERATION=LOCAL_SOFTWARE
SOFTWARE_MAIN_VERSION=0.1.0
SOFTWARE_DEV_NAME=Your Company
SOFTWARE_DEV_CONTACT=dev@example.com
SOFTWARE_DEV_COUNTRY_CODE=HU
SOFTWARE_DEV_TAX_NUMBER=12345678

# Environment: "test" or "production"
ENVIRONMENT=test

# Optional full base URL override (/invoiceService/v3). Leave blank to derive from environment.
ENDPOINT_URL=

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# In-memory cache TTL in seconds (default: 3600)
CACHE_TTL_SECONDS=3600
# Auth — minden végpont JWT-vel védett (teszthez: AUTH_ENABLED=false)
AUTH_ENABLED=true
AUTH_SERVICE_URL=http://localhost:8007
