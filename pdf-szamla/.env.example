# PDF Számla Feldolgozó — configuration

# Base URL of the graphtrek-email (graphtrek-gmail) download service
GRAPHTREK_EMAIL_URL=http://localhost:8000

# Default directory where PDFs are downloaded / read from
OUTPUT_DIR=./downloads

# Job polling controls (seconds)
DOWNLOAD_TIMEOUT=120
POLL_INTERVAL=2.0

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8001

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
