  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--host", "0.0.0.0", "--port", "8600", "--reload"],
      "jinja": true,
      "cwd": "${workspaceFolder}/moneypenny-agent"
    },
    {
      "name": "Streamlit",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "streamlit-chat-client/app.py"],
      "jinja": true
    }
  ]
}
