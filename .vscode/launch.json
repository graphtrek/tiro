  "version": "0.2.0",
  "configurations": [
    {
      "name": "nav-invoice API",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/nav-invoice/run_api.py",
      "python": "${workspaceFolder}/nav-invoice/.venv/bin/python",
      "console": "integratedTerminal"
    },
    {
      "name": "invoice-file-filter API",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/invoice-file-filter/run_api.py",
      "python": "${workspaceFolder}/invoice-file-filter/.venv/bin/python",
      "console": "integratedTerminal"
    },
    {
      "name": "attachment-downloader API",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/attachment-downloader/run_api.py",
      "python": "${workspaceFolder}/attachment-downloader/.venv/bin/python",
      "cwd": "${workspaceFolder}/attachment-downloader",
      "console": "integratedTerminal"
    },
    {
      "name": "wise API",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/wise/run_api.py",
      "python": "${workspaceFolder}/wise/.venv/bin/python",
      "cwd": "${workspaceFolder}/wise",
      "console": "integratedTerminal"
    }
  ]
}
